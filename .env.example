# RailGaadi Environment Variables Template
#
# Server-only secrets — never prefix these with NEXT_PUBLIC_
RAILRADAR_API_KEY=
# Soft daily RailRadar HTTP call budget (shared via Redis). Safe default for free tier.
RAILRADAR_DAILY_BUDGET=50
OPENWEATHER_API_KEY=
OPENTOPOGRAPHY_API_KEY=

# Public (browser-safe)
NEXT_PUBLIC_MAPTILER_API_KEY=

# Optional
OVERPASS_API_URL=https://overpass-api.de/api/interpreter

# Upstash Redis (server-only) — shared journey cache + API rate limiting + RailRadar budget
# Create a database at https://console.upstash.com and paste REST credentials here.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Web Push (server-only). Generate with: npx web-push generate-vapid-keys
# VAPID_PUBLIC_KEY is served to the browser via GET /api/notifications/vapid — never put the private key in NEXT_PUBLIC_*.
# VAPID_SUBJECT must be a mailto: or https: URL identifying the app (Web Push spec).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:railgaadi@localhost

# Vercel Cron worker (server-only). Required for GET /api/cron/notifications.
# Vercel sends Authorization: Bearer <CRON_SECRET> when this env var is set.
# Never prefix with NEXT_PUBLIC_.
CRON_SECRET=
