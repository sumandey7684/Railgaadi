# RailGaadi Environment Variables Template
#
# Server-only secrets — never prefix these with NEXT_PUBLIC_
RAILRADAR_API_KEY=
OPENWEATHER_API_KEY=
OPENTOPOGRAPHY_API_KEY=

# Public (browser-safe)
NEXT_PUBLIC_MAPTILER_API_KEY=

# Optional
OVERPASS_API_URL=https://overpass-api.de/api/interpreter

# Upstash Redis (server-only) — shared journey cache + API rate limiting
# Create a database at https://console.upstash.com and paste REST credentials here.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
